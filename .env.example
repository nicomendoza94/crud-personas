# Entorno de ejecución: development | production
NODE_ENV=development

# Dirección donde escucha el servidor.
# DEBE ser 127.0.0.1: así solo el túnel de Cloudflare (que corre en esta misma
# máquina) puede llegar a la aplicación. Ver README, sección "IP del visitante".
HOST=127.0.0.1

# Puerto local del servidor
PUERTO=3000

# --- Base de datos PostgreSQL ---
DB_HOST=127.0.0.1
DB_PUERTO=5432
DB_NOMBRE=crud_personas
# Usuario propio de la aplicación (NO usar el superusuario postgres)
DB_USUARIO=crud_app
DB_CONTRASENA=cambiar-por-la-contraseña-real

# Zona horaria para calcular la fecha actual (edad de las personas)
ZONA_HORARIA=America/Asuncion


# --- Captcha deslizante

# Política: un captcha aprobado habilita búsquedas durante X minutos o N búsquedas
CAPTCHA_VIGENCIA_MINUTOS=10
CAPTCHA_MAXIMO_BUSQUEDAS=20


# --- Geolocalización de IP (ipapi.co) ---
# Tiempo máximo de espera de la API, en milisegundos
GEOLOCALIZACION_TIEMPO_MAXIMO_MS=3000


# --- Notificaciones a Telegram ---
TELEGRAM_TOKEN_BOT=el_token_que_te_dio_BotFather


# --- Notificaciones a Telegram ---
# Token del bot (lo entrega @BotFather) e identificador del grupo (negativo).
# Ver README, sección "Notificaciones a Telegram", para obtenerlos.
TELEGRAM_TOKEN_BOT=cambiar
TELEGRAM_CHAT_ID=cambiar
# Tiempo máximo de espera de la API de Telegram, en milisegundos
TELEGRAM_TIEMPO_MAXIMO_MS=5000


# --- Auditoría ---
# Días que se conservan los registros de búsquedas (política de retención)
RETENCION_AUDITORIA_DIAS=30