# Entorno de ejecución: development | production
NODE_ENV=development

# Dirección donde escucha el servidor.
# DEBE ser 127.0.0.1: así solo el túnel de Cloudflare (que corre en esta misma
# máquina) puede llegar a la aplicación. Ver README, sección "IP del visitante".
HOST=127.0.0.1

# Puerto local del servidor
PUERTO=3000

# --- Base de datos PostgreSQL ---
DB_HOST=127.0.0.1
DB_PUERTO=5432
DB_NOMBRE=crud_personas
# Usuario propio de la aplicación (NO usar el superusuario postgres)
DB_USUARIO=crud_app
DB_CONTRASENA=cambiar-por-la-contraseña-real

# Zona horaria para calcular la fecha actual (edad de las personas)
ZONA_HORARIA=America/Asuncion


# --- Captcha (Cloudflare Turnstile) ---
# Claves de https://dash.cloudflare.com (Turnstile). Para desarrollo pueden usarse
# las claves de prueba oficiales de Cloudflare:
#   sitio:   1x00000000000000000000AA           (siempre se aprueba)
#   secreta: 1x0000000000000000000000000000000AA (siempre aprueba)
#            2x0000000000000000000000000000000AA (siempre rechaza)
#            3x0000000000000000000000000000000AA ("token ya utilizado")
TURNSTILE_CLAVE_SITIO=cambiar
TURNSTILE_CLAVE_SECRETA=cambiar

# Política: un captcha aprobado habilita búsquedas durante X minutos o N búsquedas
CAPTCHA_VIGENCIA_MINUTOS=10
CAPTCHA_MAXIMO_BUSQUEDAS=20