# Entorno de ejecución: development | production
NODE_ENV=development

# Dirección donde escucha el servidor.
# DEBE ser 127.0.0.1: así solo el túnel de Cloudflare (que corre en esta misma
# máquina) puede llegar a la aplicación. Ver README, sección "IP del visitante".
HOST=127.0.0.1

# Puerto local del servidor
PUERTO=3000